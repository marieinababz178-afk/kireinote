---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "美容のもやもやを、ちょっと軽くするノート。",
  ogImage,
} = Astro.props;

const siteUrl = "https://kireinote.pages.dev";
const canonicalUrl = Astro.url.href;
const defaultOgImage = `${siteUrl}/images/posts/cosmetics-shopping-mistakes/hero.jpg`;
const resolvedOgImage = ogImage
  ? (ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`)
  : defaultOgImage;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="kireinote" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Cloudflare Web Analytics -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "08769ce4f0294b1c87db3306b8af47f7"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </head>
  <body>

    <!-- ヘッダー -->
    <header class="site-header">
      <a href="/" class="site-title">kireinote</a>
      <div class="tagline">美容のもやもやを、ちょっと軽くするノート</div>
    </header>

    <!-- カテゴリナビゲーションバー -->
    <nav class="category-nav" aria-label="カテゴリナビゲーション">
      <div class="category-nav-inner">
        <a href="/">
          <span class="nav-icon" aria-hidden="true">&#127968;</span>
          トップ
        </a>
        <a href="/category/beauty/">
          <span class="nav-icon" aria-hidden="true">&#10024;</span>
          美容
        </a>
        <a href="/category/lifestyle/">
          <span class="nav-icon" aria-hidden="true">&#127969;</span>
          ライフスタイル
        </a>
      </div>
    </nav>

    <!-- メインコンテンツ -->
    <div class="page-wrapper">
      <slot />
    </div>

    <!-- フッター -->
    <footer class="site-footer">
      <div class="site-footer-inner">
        <nav class="footer-nav" aria-label="フッターナビゲーション">
          <a href="/">トップ</a>
          <a href="/category/beauty/">美容</a>
          <a href="/category/lifestyle/">ライフスタイル</a>
        </nav>
        <p class="footer-copy">&copy; {new Date().getFullYear()} kireinote</p>
      </div>
    </footer>

  </body>
</html>
